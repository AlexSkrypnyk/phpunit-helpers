##
# Configuration file for PHPStan static code checking, see https://phpstan.org .
#

parameters:

  level: 9

  paths:
    - benchmarks
    - src
    - tests

  excludePaths:
    - vendor/*
    - node_modules/*

  ignoreErrors:
    -
      # The traits declare their array parameters without a value type. The
      # error is reported once per class that composes the trait, so the
      # benchmarks repeat what the tests already suppress below.
      message: '#.*no value type specified in iterable type array.#'
      path: benchmarks/*
      reportUnmatched: false
    -
      # Since tests and data providers do not have to have parameter docblocks,
      # it is not possible to specify the type of the parameter, so we ignore
      # this error.
      message: '#.*no value type specified in iterable type array.#'
      path: tests/*
      reportUnmatched: false
    -
      # PHPUnit declares invokeTestMethod() from 12.5.24, so the parent call is
      # undefined when analysis runs against an older supported version.
      identifier: staticMethod.notFound
      path: src/UnitTestCase.php
      reportUnmatched: false
    -
      # PHPUnit 11 annotates assertNotEmpty() with '@phpstan-assert !empty',
      # which narrows the value so that a following emptiness guard reads as
      # always true. PHPUnit 12 dropped the annotation and needs the guard.
      identifier: notIdentical.alwaysTrue
      path: tests/Unit/LocationsTraitTest.php
      reportUnmatched: false
